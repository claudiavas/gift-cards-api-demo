{
  "name": "gift-cards-api",
  "version": "1.0.0",
  "description": "API segura para gestionar tarjetas regalo Amazon con encriptación y auditoría",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit",
    "test:encryption": "jest tests/unit/encryption.test.js",
    "test:sanitizer": "jest tests/unit/sanitizer.test.js",
    "test:rateLimit": "jest tests/unit/rateLimit.test.js",
    "test:coverage": "jest --coverage",
    "setup:bigquery": "node scripts/setup-bigquery.js",
    "setup:ntp": "bash scripts/ntp-sync.sh",
    "setup:scheduler": "bash scripts/cloud-scheduler-setup.sh",
    "deploy:cloudrun": "bash scripts/deploy-cloud-run.sh",
    "docker:build": "docker build -t gift-cards-api:latest .",
    "docker:run": "docker-compose up",
    "docker:stop": "docker-compose down"
  },
  "keywords": ["amazon", "gift-cards", "encryption", "bigquery", "security"],
  "author": "Claudia Vásquez <claudia.vasquez.as@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "aws4": "^1.12.0",
    "@google-cloud/bigquery": "^7.0.0",
    "@sendgrid/mail": "^8.1.0",
    "uuid": "^9.0.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^3.0.0"
  }
}
