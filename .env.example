# ============================================================================
# DEMO MODE
# ============================================================================
# Con DEMO_MODE=true la API arranca sin credenciales reales:
# Amazon, SendGrid y el CRM se simulan. Si además no hay DATABASE_URL,
# el almacén es en memoria.
DEMO_MODE=false

# ============================================================================
# CONFIGURACIÓN - Gift Cards API
# ============================================================================
# IMPORTANTE: Copiar este archivo a .env y completar con tus credenciales reales
# NUNCA commitear .env al repositorio

# ============================================================================
# AMAZON INCENTIVES API
# ============================================================================
# Obtener credenciales en: https://developer.amazon.com/incentives
AMAZON_PARTNER_ID=your-partner-id
AMAZON_ACCESS_KEY=AKIA...
AMAZON_SECRET_KEY=your-secret-key
AMAZON_REGION=us-east-1
# Cambiar a "production" cuando está listo para ir en vivo
AMAZON_ENV=sandbox

# ============================================================================
# POSTGRESQL
# ============================================================================
# Connection string de PostgreSQL (Railway, Cloud SQL, Supabase, local...)
# El esquema se crea automáticamente al arrancar (ver sql/create_tables.sql)
DATABASE_URL=postgresql://user:password@localhost:5432/gift_cards
# Poner a true si el proveedor requiere SSL (conexiones externas a Railway/Heroku)
DATABASE_SSL=false

# ============================================================================
# SENDGRID - Email
# ============================================================================
# API key de SendGrid (obtener en: https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=SG.your-api-key
# Email remitente para tarjetas regalo
SENDGRID_FROM_EMAIL=noreply@acme-example.com
# ID de la plantilla de SendGrid (crear en: https://app.sendgrid.com/dynamic_templates)
SENDGRID_TEMPLATE_ID=d-your-template-id

# ============================================================================
# CRM DE ORIGEN (genérico: Zoho, HubSpot, Salesforce, backoffice propio...)
# ============================================================================
# URL base de la API del CRM
CRM_API_URL=https://crm.example.com/api
# Token de autenticación del CRM (OAuth u otro)

CRM_AUTH_TOKEN=your-crm-auth-token



# ============================================================================
# APLICACIÓN
# ============================================================================
# Puerto donde corre el servidor
API_PORT=3000
# Ambiente: development, staging, production
NODE_ENV=development
# Clave API para proteger endpoints (generar con: openssl rand -base64 32)
API_KEY=your-secure-api-key-min-32-chars
# Mostrar logs detallados (true/false)
DEBUG=true

# ============================================================================
# ENCRIPTACIÓN
# ============================================================================
# Clave para AES-256 (32 caracteres en base64)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRÍTICO: Guardar en secreto, nunca en git
ENCRYPTION_KEY=your-32-character-base64-encryption-key

# ============================================================================
# ALERTAS Y NOTIFICACIONES
# ============================================================================
# Email donde enviar alertas de errores críticos (ej: fondos insuficientes)
CRM_ALERT_EMAIL=crm@acme-example.com
# Nombre del dominio para logs y debugging
APP_NAME=gift-cards-api-demo
# Versión de la API
API_VERSION=1.0.0

# ============================================================================
# CLOUD LOGGING (Google Cloud)
# ============================================================================
# Nombre del proyecto en Cloud Logging
CLOUD_LOG_NAME=gift-cards-api
# Nivel mínimo de log: trace, debug, info, warn, error
LOG_LEVEL=info
